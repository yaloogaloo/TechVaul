# Local environment. Recreate with the project interpreter; do not upload it.
.venv/
venv/
env/

# Bytecode and test caches.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Packaging output.
build/
/dist/
*.egg-info/
.eggs/

# Frontend toolchain (keep frontend/dist for packaged desktop UI).
frontend/node_modules/
frontend/dist-ssr/

# Archive root only when it sits at the repository root.
# src/techvault/archive/ is source and must stay tracked.
/archive/

# Local databases, credentials, and logs.
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db

# Source-checkout runtime data: database, archive root, and README image pool.
/data/

# Live video downloads stay out of git. Screenshots and JSON are stored separately.
/tmp-video-live/
/tmp-video-route/
/tmp-video-ui/
/tmp-cover-debug/
/tmp-smoke-appdata/

# Live-validation binaries and upstream README text. Screenshots and JSON stay.
docs/github/evidence/voicestudio_pool/
docs/github/evidence/capture_db/
docs/github/evidence/voicestudio_readme.md
docs/github/evidence/voicestudio_present.html
.env
.env.*
*.log

# Editor and OS clutter.
.idea/
.vscode/
Thumbs.db
Desktop.ini
.DS_Store
